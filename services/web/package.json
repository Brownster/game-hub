{
  "name": "gamehub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "assets:chess": "blender --background --python ../../assets/blender/render_chess.py -- --out .render-cache/chess --resolution 512 --samples 96 && python3 ../../assets/blender/trim_sprites.py .render-cache/chess public/chess/pieces/wood",
    "assets:reversi": "blender --background --python ../../assets/blender/render_reversi.py -- --out public/reversi --resolution 256 --samples 160"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.0.20",
    "@fontsource/dm-serif-display": "^5.0.20",
    "@fontsource/indie-flower": "^5.0.17",
    "@fontsource/orbitron": "^5.0.17",
    "@fontsource/rajdhani": "^5.0.17",
    "@fontsource/vt323": "^5.0.16",
    "chess.js": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^27.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.16"
  }
}
